# Placeholders only. Nothing in this repo reads a .env file by itself:
# export these in your shell (or a systemd EnvironmentFile) before starting the studio / publish CLI.
# NEVER commit a real .env, tokens, cookies or API keys.

# Streamer you credit in every caption (needs their permission)
CLIPPER_CREDIT=@StreamerHandle

# Where the engine writes data (default: <repo>/data)
# CLIPPER_ROOT=/path/to/data

# Where YOUR uploader scripts and credential files live (default: ~/.clipper)
# lanes/ holds one script per destination, e.g. lanes/yt_upload.py
CLIPPER_SECRETS=/path/to/private/folder

# Studio dashboard port (always bound to 127.0.0.1)
STUDIO_PORT=8790

# Real posting stays OFF unless this is exactly "true" AND auto_publish is on in settings AND you pass --live.
AUTO_PUBLISH=false

# Optional: script that scans a clip for copyrighted music and prints "VERDICT: ..."
# CLIPPER_COPYRIGHT_CHECK=/path/to/check_music.py
